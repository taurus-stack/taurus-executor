# Taurus Server Configuration
TAURUS_SERVER_URL=http://localhost:8000
TAURUS_HOST_UUID=your-host-uuid-here

# TLS Configuration
# Server certificate paths (for mTLS)
TLS_SERVER_CERT_PATH=/path/to/server.crt
TLS_SERVER_KEY_PATH=/path/to/server.key
TLS_CA_PATH=/path/to/ca.crt

# Client certificate paths (for SDK/CLI connecting to other executors)
# TLS_CERT_PATH=/path/to/client.crt
# TLS_KEY_PATH=/path/to/client.key

# gRPC Configuration
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# Update Configuration
UPDATE_CHECK_INTERVAL_SECONDS=3600
CURRENT_VERSION=0.1.0